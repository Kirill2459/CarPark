<Window x:Class="ViewWPF.AddOwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewWPF"
        mc:Ignorable="d"
        Title="AddOwnerWindow" Height="408" Width="408">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="ДОБАВЛЕНИЕ ВЛАДЕЛЬЦА"
                  FontSize="16" FontWeight="Bold"
                  HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Поля ввода -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Имя -->
            <TextBlock Grid.Row="0" Grid.Column="0" 
                      Text="Имя" 
                      FontSize="14"
                      VerticalAlignment="Center" Margin="0,15"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                    x:Name="textBoxName"
                    FontSize="14" Height="30"
                    Margin="10,15" Text="{Binding Name}"/>

            <!-- Возраст -->
            <TextBlock Grid.Row="1" Grid.Column="0" 
                      Text="Возраст" 
                      FontSize="14"
                      VerticalAlignment="Center" Margin="0,15"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                    x:Name="textBoxAge"
                    FontSize="14" Height="30"
                    Margin="10,15" Text="{Binding Year}"/>

            <!-- Стаж вождения -->
            <TextBlock Grid.Row="2" Grid.Column="0" 
                      Text="Стаж вождения" 
                      FontSize="14"
                      VerticalAlignment="Center" Margin="0,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                    x:Name="textBoxExperience"
                    FontSize="14" Height="30"
                    Margin="10,15" Text="{Binding ExperienceYear}"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="buttonCancel" Content="Отмена" 
                   Width="120" Height="45" 
                   FontSize="12" Margin="10,0" Command="{Binding CancelCommand}"/>
            <Button x:Name="buttonAdd" Content="Добавить" 
                   Width="120" Height="45" 
                   FontSize="12" Margin="10,0" Command="{Binding AddOwnerCommand}"/>
        </StackPanel>
    </Grid>
</Window>
